{
  "name": "it-depends",
  "version": "0.1.0",
  "private": true,
  "description": "An interactive course on software architecture decision-making, played as a campaign on a living blueprint.",
  "license": "MIT",
  "homepage": "https://rodacato.github.io/it-depends/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rodacato/it-depends.git"
  },
  "bugs": "https://github.com/rodacato/it-depends/issues",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate:content && npm run build:manifest && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:content": "tsx scripts/validate-content.ts",
    "check:i18n": "tsx scripts/check-i18n.ts",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test --grep @smoke",
    "demo": "npm run build && node scripts/record-demo.mjs",
    "build:manifest": "tsx scripts/build-manifest.ts"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "framer-motion": "^12.0.0",
    "pixi.js": "^8.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "jsdom": "^30.1.3",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
